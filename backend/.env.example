OCR_MAX_UPLOAD_MB=5
OCR_MAX_PAGES=10
OCR_LANGUAGES=vie+eng
OCR_TEMP_TTL_SECONDS=300
OCR_ENABLE_EXTERNAL_VISION=false
OCR_REPORT_DIR=artifacts/ocr/reports
OCR_LOG_FILE=artifacts/ocr/logs/ocr-events.jsonl
OCR_RUNTIME_DIR=runtime/ocr
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
