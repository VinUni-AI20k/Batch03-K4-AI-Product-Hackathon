# Copy thành .env rồi điền giá trị thật (tên biến theo chuẩn Hermes Agent)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
VOYAGE_API_KEY=                    # bỏ trống nếu index.embedding_provider=local

# Kênh chat — có token kênh nào thì `learning-agent bot` bật kênh đó
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# Agent cá nhân: giới hạn ai được dùng (user id, phân cách dấu phẩy). Rỗng = cho tất cả (dev)
DISCORD_ALLOWED_USERS=
TELEGRAM_ALLOWED_USERS=
