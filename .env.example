# ===== CẤU HÌNH API KEYS =====

# Cách 1: Key Google AI Studio (Gemini)
GEMINI_API_KEY=AIzaSy-your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Cách 2: Key OpenAI hoặc Cockpit Local Proxy
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=http://localhost:59116/v1   # Mở comment nếu dùng Cockpit Tools

# Chạy pytest thật trên repo do AI sinh (1 = bật, 0 = tắt).
VLEARN_RUN_TESTS=1
