# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here

# LLM API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Role ID to mention/escalate (TA Role ID)
TA_ROLE_ID=your_ta_role_id_here

# (Optional) Allowed channel ID for the bot to respond to all messages, or leave blank to respond everywhere
ALLOWED_CHANNEL_ID=

# Bot Prefix
PREFIX=!ask

# Live Discord Room/Channel Synchronization IDs (Leave blank to fallback to local JSON mock files)
ANNOUNCEMENT_CHANNEL_ID=your_announcement_channel_id_here
RESOURCE_CHANNEL_ID=your_resource_channel_id_here
DISCUSSION_CHANNEL_IDS=comma_separated_discussion_channel_ids_here
