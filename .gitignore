# Runtime artifacts (commit only reviewed, anonymized evidence)
artifacts/conversations/*
!artifacts/conversations/.gitkeep
artifacts/evaluation-runs/*
!artifacts/evaluation-runs/.gitkeep
artifacts/traces/*
!artifacts/traces/.gitkeep
artifacts/exports/*
!artifacts/exports/.gitkeep
