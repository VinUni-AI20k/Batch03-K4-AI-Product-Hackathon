# Copy thành .env rồi điền giá trị thật.

# ── LLM ── chọn provider ở config.yaml (llm.provider), điền key tương ứng ở đây.
# Chỉ cần điền key của provider bạn dùng, các dòng khác để trống.
OPENAI_API_KEY=
OPENROUTER_API_KEY=          # dùng Claude/Gemini/Llama... qua một key (model 'anthropic/claude-...')
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
# provider=custom thì dùng 2 dòng này (bất kỳ endpoint OpenAI-compatible):
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# ── Embedding ──
VOYAGE_API_KEY=              # free 200M token; bỏ trống thì dùng embedding local

# ── Tool nghiên cứu (mặc định bật) ── web/reddit/github chạy KHÔNG cần key; các key sau là TUỲ CHỌN để mạnh hơn
GITHUB_TOKEN=               # tăng rate limit GitHub (60→5000 req/h)
X_BEARER_TOKEN=             # để tìm X/Twitter qua API; bỏ trống thì tìm qua web scope x.com

# ── Maton (nối SaaS: Google Calendar/Gmail/Docs/HubSpot...) ── bật ở dashboard Config → Integrations
MATON_API_KEY=              # lấy tại dashboard.maton.ai; nối app SaaS trong dashboard Maton trước

# ── Kênh chat ── có token kênh nào thì `learning-agent bot` bật kênh đó
DISCORD_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=

# ── Agent cá nhân: giới hạn ai được dùng (user id, phân cách dấu phẩy). Rỗng = cho tất cả (dev) ──
DISCORD_ALLOWED_USERS=
TELEGRAM_ALLOWED_USERS=
