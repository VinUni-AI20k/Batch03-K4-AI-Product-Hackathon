OPENAI_API_KEY=

# URLs of the locally-run MCP servers (see codebase/mcp/discord_mcp and
# codebase/mcp/google_calendar_mcp READMEs to start them). Defaults match
# those servers' default ports.
DISCORD_MCP_URL=http://localhost:8085/mcp
GOOGLE_CALENDAR_MCP_URL=http://localhost:8086/mcp

# Gmail/Discord/Calendar credentials (DISCORD_TOKEN, GOOGLE_CLIENT_SECRETS_FILE,
# GMAIL_MCP_*) live in codebase/mcp/.env, not here — chat.py loads that file
# too (see env_loader.py).
