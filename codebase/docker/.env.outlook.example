# Outlook Local MCP Environment Configuration Example
# Copy this file to .env.outlook and adjust values as needed.

# Image & Volume
OUTLOOK_MCP_IMAGE=ghcr.io/desek/outlook-local-mcp:latest
OUTLOOK_MCP_VOLUME=outlook-mcp-auth

# Azure App Registration (Default: Microsoft Outlook Desktop public client ID)
OUTLOOK_MCP_CLIENT_ID=d3590ed6-52b3-4102-aeff-aad2292ab01c
OUTLOOK_MCP_TENANT_ID=common

# General Settings
OUTLOOK_MCP_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
OUTLOOK_MCP_LOG_LEVEL=warn

# Mail Permissions & Scope
OUTLOOK_MCP_MAIL_ENABLED=true
OUTLOOK_MCP_MAIL_MANAGE_ENABLED=false
OUTLOOK_MCP_READ_ONLY=true
