# ── AI Provider ──────────────────────────────────────────────────────────────
# Priority: Gemini (if GEMINI_API_KEY is set) → Ollama local (llama3.2:1b)

# [Option 1] Google Gemini API key
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# [Option 2] Ollama local fallback (used automatically when GEMINI_API_KEY is empty)
# Run: ollama pull llama3.2:1b && ollama serve
OLLAMA_MODEL=llama3.2:1b
OLLAMA_BASE_URL=http://localhost:11434

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
PORT=3001

# Set to "false" to disable static demo fallback when both AI providers fail
DEMO_FALLBACK=true
