# ============================================================
# AI Agent QA — VinUni AI Thực Chiến Batch 03
# Copy file này thành .env và điền key của bạn
# ============================================================

# --- LLM Provider (chọn 1, ưu tiên theo thứ tự: Anthropic > OpenAI > Gemini) ---

# Anthropic Claude (khuyến nghị)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Google Gemini
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# --- Tắt LLM (chỉ dùng local RAG) ---
# USE_LLM=false

# --- Knowledge Base paths (mặc định dùng data/ trong codebase/) ---
# FB_KB_PATH=data/fb_group_qa.json
# VLEARN_KB_PATH=data/vlearn_kb.json

# --- Server ---
# APP_HOST=0.0.0.0
# APP_PORT=8000
