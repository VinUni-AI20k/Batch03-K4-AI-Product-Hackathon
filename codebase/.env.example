# Copy sang .env rồi điền. KHONG commit .env — .gitignore đã chặn.
#   Windows PowerShell:  Copy-Item .env.example .env
#   Bash:                cp .env.example .env

# Developer Portal → tab Bot → Reset Token
DISCORD_TOKEN=

# aistudio.google.com/apikey → Create API key (free tier, không cần thẻ)
GEMINI_API_KEY=

# ID server test của bạn (bật Developer Mode trong Discord → chuột phải server → Copy Server ID)
GUILD_ID=

# Tên các kênh được index, cách nhau bằng dấu phẩy.
# Bỏ trống = index mọi kênh bot có quyền đọc.
# spec.md §4 giới hạn 5 kênh — điền đúng 5 tên kênh trên server test.
KENH_INDEX=thong-bao,tai-nguyen,thong-bao-chung,ly-thuyet-k3,lab-k3
