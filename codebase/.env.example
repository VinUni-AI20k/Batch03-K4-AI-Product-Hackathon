# Copy file này thành `.env` (cùng thư mục) rồi điền key.
# KHÔNG commit `.env` — đã có trong .gitignore.

# --- Bắt buộc: key OpenRouter (1 key gọi được nhiều model qua endpoint OpenAI-compatible) ---
OPENROUTER_API_KEY=

# --- Tuỳ chọn: đổi model mặc định (openai/gpt-4o-mini) ---
# Xem danh sách model tại https://openrouter.ai/models
# OPENROUTER_MODEL=openai/gpt-4o-mini
