# Copy to .env in this same folder. NEVER commit .env (gitignored).
# OpenRouter recommended — one key covers many models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Allow the static frontend (served separately) to call this API.
CORS_ORIGIN=http://localhost:8000
