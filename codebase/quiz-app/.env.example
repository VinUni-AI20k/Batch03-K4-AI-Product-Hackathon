# Copy file này thành .env rồi điền key thật — KHÔNG commit file .env (đã có trong .gitignore gốc: *.env)
PORT=5000

# ==============================================================================
# Chọn provider AI (gộp OpenAI/DeepSeek/Claude/Gemini qua LiteLLM — xem
# services/model_factory.py). Chỉ cần set PROVIDER + LLM_MODEL + đúng 1 API key
# tương ứng bên dưới, KHÔNG cần sửa code khi đổi provider.
# ==============================================================================
PROVIDER=openai
LLM_MODEL=gpt-5.6-terra

# --- Chỉ điền API key của provider bạn CHỌN ở trên (để trống các dòng còn lại) ---
OPENAI_API_KEY=dan_api_key_openai_vao_day_KHONG_dan_vao_file_nay
# DEEPSEEK_API_KEY=dan_api_key_deepseek_vao_day
# ANTHROPIC_API_KEY=dan_api_key_claude_vao_day
# GEMINI_API_KEY=dan_api_key_gemini_vao_day

# Ví dụ đổi sang DeepSeek: PROVIDER=deepseek, LLM_MODEL=deepseek-v4-flash, điền DEEPSEEK_API_KEY
# Ví dụ đổi sang Claude:   PROVIDER=claude,   LLM_MODEL=<tên model claude>,  điền ANTHROPIC_API_KEY
# Ví dụ đổi sang Gemini:   PROVIDER=gemini,   LLM_MODEL=<tên model gemini>,  điền GEMINI_API_KEY
