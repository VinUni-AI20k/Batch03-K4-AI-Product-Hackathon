DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
# No DISCORD_GUILD_ID here on purpose — the bot can be invited into more than
# one server, and discord_bot.resolve_guild() picks the default dynamically
# from whichever guild(s) it's actually in (see list_guilds/get_server_info).
# Application ID from Discord Developer Portal > General Information. Used by
# the backend's "Quản lý kết nối" > Discord button to build a real (View
# Channels + Read Message History only) bot invite URL — see
# codebase/backend/discord_connection.py.
DISCORD_CLIENT_ID=
MCP_HOST=0.0.0.0
MCP_PORT=8085

# Point these at codebase/backend/credentials/ so this MCP server reads the
# SAME token the unified "Quản lý kết nối" > Gmail flow writes (see
# codebase/backend/google_connection.py) instead of running its own separate
# OAuth handshake. Paths are relative to this MCP server's process cwd
# (codebase/mcp, per README's `cd mcp`) — use absolute paths if you run it
# from elsewhere.
GOOGLE_CLIENT_SECRETS_FILE=../backend/credentials/client_secret.json
GOOGLE_CALENDAR_TOKEN_FILE=../backend/credentials/token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_DEFAULT_TZ=Asia/Ho_Chi_Minh
GOOGLE_CALENDAR_MCP_HOST=0.0.0.0
GOOGLE_CALENDAR_MCP_PORT=8086

# outlook_mcp — no Azure app registration needed, see outlook_mcp/README.md
OUTLOOK_MCP_IMAGE=outlook-local-mcp:local
OUTLOOK_MCP_VOLUME=outlook-mcp-auth
OUTLOOK_MCP_CLIENT_ID=d3590ed6-52b3-4102-aeff-aad2292ab01c
OUTLOOK_MCP_TENANT_ID=common
OUTLOOK_MCP_MAIL_ENABLED=true
OUTLOOK_MCP_MAIL_MANAGE_ENABLED=false
OUTLOOK_MCP_READ_ONLY=false
OUTLOOK_MCP_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
OUTLOOK_MCP_LOG_LEVEL=warn

# gmail_mcp — local MCP server calling the real Gmail REST API directly
# (gmail.googleapis.com), same shared token as google_calendar_mcp above.
# See codebase/mcp/gmail_mcp/README.md. GOOGLE_CALENDAR_TOKEN_FILE (set
# above) is reused here too — it's the same physical token file.
GMAIL_LOCAL_MCP_HOST=0.0.0.0
GMAIL_LOCAL_MCP_PORT=8087
