DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_GUILD_ID=OPTIONAL_DEFAULT_SERVER_ID
MCP_HOST=0.0.0.0
MCP_PORT=8085

# GOOGLE_CLIENT_SECRETS_FILE / GOOGLE_CALENDAR_TOKEN_FILE default to
# google_calendar_mcp/credentials/{client_secret,token}.json — only set these
# if you want them somewhere else.
# GOOGLE_CLIENT_SECRETS_FILE=/path/to/client_secret.json
# GOOGLE_CALENDAR_TOKEN_FILE=/path/to/token.json
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_DEFAULT_TZ=Asia/Ho_Chi_Minh
GOOGLE_CALENDAR_MCP_HOST=0.0.0.0
GOOGLE_CALENDAR_MCP_PORT=8086

# outlook_mcp — no Azure app registration needed, see outlook_mcp/README.md
OUTLOOK_MCP_IMAGE=outlook-local-mcp:local
OUTLOOK_MCP_VOLUME=outlook-mcp-auth
OUTLOOK_MCP_CLIENT_ID=d3590ed6-52b3-4102-aeff-aad2292ab01c
OUTLOOK_MCP_TENANT_ID=common
OUTLOOK_MCP_MAIL_ENABLED=true
OUTLOOK_MCP_MAIL_MANAGE_ENABLED=false
OUTLOOK_MCP_READ_ONLY=false
OUTLOOK_MCP_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
OUTLOOK_MCP_LOG_LEVEL=warn

# gmail_mcp_client — Gmail MCP server chinh thuc cua Google. Khong commit .env vao Git.
GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1

# Cach 1 (khuyen dung): OAuth client tao trong Google Cloud Console.
# Them http://localhost:8765/oauth/callback vao Authorized redirect URIs cua client.
GMAIL_MCP_OAUTH_CLIENT_ID=
GMAIL_MCP_OAUTH_CLIENT_SECRET=
GMAIL_MCP_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/callback
# Mac dinh chi cho phep doc. Khong bat neu agent khong can thay doi Gmail.
GMAIL_MCP_ALLOW_WRITE=false

# Cach 2: access token da duoc cap boi OAuth flow cua ban.
GMAIL_MCP_ACCESS_TOKEN=

# Chi can dat khi dung server khac Google va tool co ten khac.
# GMAIL_MCP_SEARCH_TOOL=search_threads
# GMAIL_MCP_READ_TOOL=get_thread
